PORT=5000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=college_enquiry_chatbot

# Auth (JWT) — bcrypt-compatible password hashes are generated by bcryptjs
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Optional: Google Cloud Translation API key for EN ⇄ HI/TA/ML on dynamic answers
# https://cloud.google.com/translate/docs/setup
GOOGLE_TRANSLATE_API_KEY=

# First-time admin creation (used by npm run bootstrap:admin)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin@123
BOOTSTRAP_ADMIN_EMAIL=admin@college.edu

# CORS (comma-separated). Example: http://localhost:5500,http://127.0.0.1:5500
CORS_ORIGINS=
